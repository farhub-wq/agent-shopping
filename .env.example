# ---- 基础设施 ----
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
REDIS_URL=redis://redis:6379/0

# ---- 服务端口（容器内固定 8000，宿主机映射见 docker-compose.yml）----
GATEWAY_URL=http://gateway:8000
CATALOG_URL=http://catalog:8000
INVENTORY_URL=http://inventory:8000
ORDER_URL=http://order:8000
FULFILLMENT_URL=http://fulfillment:8000
AFTERSALES_URL=http://aftersales:8000
HARNESS_URL=http://harness:8000

# ---- 安全 ----
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=900
# 内网身份头签名密钥：生产必须注入随机值，禁止用默认密钥上线
INTERNAL_SIGNING_SECRET=dev-internal-signing-secret
# 本地开发信任网关签名的身份头；生产保持 true 但靠内网隔离+密钥保护
TRUST_IDENTITY_HEADERS=true
# 自选角色换 token 接口：仅本地演示用，生产必须为 false
AUTH_DEV_MODE=false
# 运行环境：prod 下 Cookie 加 secure
ENV=dev
# 空库时引导第一个管理员（可留空则不引导）；密码不落日志
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
IDENTITY_URL=http://identity:8000

# ---- 模型接入（留空则使用内置离线确定性模型）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_DIM=256

# ---- 沙箱 ----
# 设为 true 前先构建镜像：docker build -t shop-agent-sandbox:latest infra/sandbox
# 未启用或镜像缺失时会降级到本地子进程（仅防误操作，不是安全边界）
SANDBOX_IMAGE=shop-agent-sandbox:latest
SANDBOX_ENABLED=false
SANDBOX_CPU=0.5
SANDBOX_MEMORY_MB=256
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_NETWORK=none

# ---- 业务参数 ----
FLASH_SALE_STOCK=20
FULFILLMENT_SLA_HOURS=48
REFUND_WINDOW_DAYS=7
