# ---- 基础设施 ----
# MySQL 8：每个微服务一个库，应用账号与 infra/mysql/init.sql 的授权账号保持一致
MYSQL_ROOT_PASSWORD=shop-root
MYSQL_USER=shop
MYSQL_PASSWORD=shop
# Harness 的记忆与 Agent 轨迹存 MongoDB
MONGO_URL=mongodb://mongo:27017
MONGO_DB=shop_harness
REDIS_URL=redis://redis:6379/0

# ---- 服务端口（容器内固定 8000，宿主机映射见 docker-compose.yml）----
GATEWAY_URL=http://gateway:8000
CATALOG_URL=http://catalog:8000
INVENTORY_URL=http://inventory:8000
ORDER_URL=http://order:8000
FULFILLMENT_URL=http://fulfillment:8000
AFTERSALES_URL=http://aftersales:8000
HARNESS_URL=http://harness:8000
IDENTITY_URL=http://identity:8000
PAYMENT_URL=http://payment:8000
AUDIT_URL=http://audit:8000

# ---- 支付（M2 Mock 渠道）----
PAYMENT_PROVIDER=mock
# 回调 HMAC 签名密钥：生产必须注入 ≥32 字符随机值（python -c "import secrets;print(secrets.token_urlsafe(32))"），禁止用默认值上线
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
# 本地 mock 收银台开关：仅 ENV=dev 时生效，生产必须为 false
PAYMENT_MOCK_MODE=true
PAYMENT_TTL_SECONDS=900
PAYMENT_FEE_BPS=60
# 浏览器可访问的网关地址，mock 收银台 pay_url 指向这里
PAYMENT_PUBLIC_BASE_URL=http://localhost:8080

# ---- 安全 ----
# 生产必须注入 ≥32 字符随机值（python -c "import secrets;print(secrets.token_urlsafe(32))"），否则启动守卫拒绝启动
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=900
# 内网身份头签名密钥：生产必须注入 ≥32 字符随机值，禁止用默认密钥上线
INTERNAL_SIGNING_SECRET=dev-internal-signing-secret
# 管理员 TOTP 共享密钥的 Fernet 加密主密钥（32 字节 urlsafe-base64）：生产必须注入随机值
MFA_ENCRYPTION_KEY=0y5-6ym0zsmuIEBUg5OL133pRODLkiRFpQhgbIVZWmU=
# 本地开发信任网关签名的身份头；生产保持 true 但靠内网隔离+密钥保护
TRUST_IDENTITY_HEADERS=true
# 自选角色换 token 接口：仅本地演示用，生产必须为 false
AUTH_DEV_MODE=false
# 运行环境：prod 下 Cookie 加 secure
ENV=dev
# 空库时引导第一个管理员（可留空则不引导）；密码不落日志
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- 模型接入（留空则使用内置离线确定性模型）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_DIM=256
# 嵌入模型（base_url + api_key 齐备才启用真实语义向量，否则回退哈希）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=15
# 降级模型（可选）：留空则降级到内置离线确定性规划器
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# 模型熔断：主模型 15s 超时、连续 3 次失败熔断 300s，熔断/失败后走降级模型
LLM_TIMEOUT_SECONDS=15
LLM_FAILURE_THRESHOLD=3
LLM_COOLDOWN_SECONDS=300

# ---- MCP（留空则不接远端 MCP Server）----
# 逗号分隔的 name=endpoint 列表，例：ops=http://ops:8000/mcp,erp=http://erp:8000/mcp
MCP_HTTP_SERVERS=

# ---- 沙箱 ----
# 沙箱由独立 sandbox-runner 执行（唯一持有 Docker socket）；harness 只经 HTTP 调用
# 多主机时列全所有 runner（逗号分隔），harness 自动轮询与故障转移；compose 部署时由 compose 覆盖为 http://sandbox-runner:8000
SANDBOX_RUNNER_URLS=http://localhost:8011
# 单实例并发上限与排队超时：超过并发先排队，排队超时返回繁忙，由 harness 转移
SANDBOX_MAX_CONCURRENCY=4
SANDBOX_QUEUE_TIMEOUT_SECONDS=10
# 跨 runner 重复执行防护：同一 execution_id 在其他 runner 执行中时等待结果复用的时长
SANDBOX_DEDUPE_WAIT_SECONDS=5
# 先构建执行镜像：make build-sandbox-image（会打印内容寻址的 SANDBOX_IMAGE）
# 生产必须填 digest 固定形式（repo@sha256:... 或 sha256:...），tag 会被启动守卫拒绝
# 未启用时走本地子进程（仅防误操作，不是安全边界）；启用后 runner 不可用即拒绝，绝不回退本地
SANDBOX_IMAGE=shop-agent-sandbox:latest
SANDBOX_ENABLED=false
# 生产硬上限：SANDBOX_CPU ≤ 2.0、SANDBOX_MEMORY_MB ≤ 2048，超限拒绝启动
SANDBOX_CPU=0.5
SANDBOX_MEMORY_MB=256
SANDBOX_TIMEOUT_SECONDS=20
# 生产锁死 none；改成 bridge/host 会让 runner 拒绝启动
SANDBOX_NETWORK=none
# 生产必须接 rootless dockerd 并启用 gVisor：本地开发留空即可（走默认 socket + runc）
# 容器内端点路径由 prod overlay 固定为 unix:///run/rootless/docker.sock
SANDBOX_DOCKER_HOST=
SANDBOX_RUNTIME=
# 宿主 rootless socket 路径（prod overlay 挂载用），由 infra/rootless-docker/setup.sh 打印实际值
SANDBOX_ROOTLESS_SOCKET=/run/user/1000/docker.sock

# ---- 业务参数 ----
FLASH_SALE_STOCK=20
FULFILLMENT_SLA_HOURS=48
REFUND_WINDOW_DAYS=7

# ---- 可观测 ----
# Grafana 初始管理员密码：生产必须注入强口令，禁止用默认值上线
GRAFANA_ADMIN_PASSWORD=admin
